# ========================================
# Smart Agriculture Assistant - Environment Template
# Copy this file to .env and fill in your values
# ========================================

# Server Configuration
PORT=5001
API_HOST=0.0.0.0
HOST=0.0.0.0

# Network IP Addresses
BACKEND_IP=localhost
FRONTEND_IP=localhost
DATABASE_IP=localhost

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/Demo

# ========================================
# External API Keys (Optional / Feature Specific)
# ========================================

# OpenWeather API (Weather Forecast)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Plant Diagnosis API (Plant.id)
CROP_DIAGNOSIS_API_KEY=your_crop_diagnosis_api_key_here

# Crop Recommendation API
CROP_RECOMMENDATION_API_KEY=your_crop_rec_api_key_here

# Market Prices API (data.gov.in)
MARKET_API_KEY=your_market_api_key_here

# Contact Expert API
CONTACT_EXPERT_API_KEY=your_expert_api_key_here

# OpenAI API (AI Chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI (Gemini) API
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Nearby Stores API
NEARBY_STORES_API_KEY=your_nearby_stores_api_key_here

# Debug Mode
DEBUG=true
